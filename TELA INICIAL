<!-- TELA INICIAL -->

<div id="homeScreen">

  <div class="home-content">

    <img
      src="assets/smartcart-logo.png"
      alt="SmartCart"
      class="home-logo"
    >

    <h1>SmartCart</h1>

    <p>
      Seu carrinho na palma da mão
    </p>

    <button id="startBtn" class="start-btn">
      COMEÇAR
    </button>

  </div>

</div>

/* TELA INICIAL */

#homeScreen{
  position:fixed;
  inset:0;

  background:
  radial-gradient(
    ellipse at 50% -10%,
    #09295b,
    #030b1d 45%,
    #020715 80%
  );

  display:flex;
  justify-content:center;
  align-items:center;

  z-index:9999;
}

.home-content{
  text-align:center;
}

.home-logo{
  width:280px;
  max-width:80%;
  margin-bottom:20px;

  animation: glow 2s infinite alternate;
}

@keyframes glow{

  from{
    filter:drop-shadow(0 0 10px #08d8ff);
  }

  to{
    filter:drop-shadow(0 0 25px #08d8ff);
  }

}

.home-content h1{
  margin:0;
  font-size:42px;
}

.home-content p{
  color:#9bb3d4;
  margin-top:10px;
  margin-bottom:35px;
}

.start-btn{
  padding:16px 45px;

  border:none;

  border-radius:16px;

  background:
  linear-gradient(
    135deg,
    #08d8ff,
    #087dff
  );

  color:white;

  font-size:18px;

  font-weight:700;

  cursor:pointer;

  box-shadow:
  0 0 25px rgba(8,216,255,.35);

  transition:.3s;
}

.start-btn:hover{
  transform:translateY(-3px);
}

<main class="app" id="controlScreen" style="display:none;">

document
.getElementById("startBtn")
.addEventListener("click", () => {

  document
  .getElementById("homeScreen")
  .style.display = "none";

  document
  .getElementById("controlScreen")
  .style.display = "block";

});
